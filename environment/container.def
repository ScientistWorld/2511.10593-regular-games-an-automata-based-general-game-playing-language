# Apptainer definition file for this environment.
#
# Build:  apptainer build container.sif container.def
#
# The container packages everything a scientist agent needs to work on
# this paper's task. The agent's workspace is bind-mounted at /home/user
# at runtime — it is NOT baked into the container.
#
# Security boundary:
#   - test_labels and test_final_state.py NEVER enter the container
#   - solution/ NEVER enters the container
#   - Only training data and test features are included
#
# *** IMPORTANT ***
# Python packages (torch, transformers, etc.) go in setup.sh, NOT here.
# Only OS-level packages (apt-get) belong in %post.
# Putting pip install in %post is the #1 cause of build failures.

Bootstrap: docker
From: rust:1.89-bookworm

# --- GPU / CUDA base (uncomment if your paper needs GPU) ---
# Bootstrap: docker
# From: nvidia/cuda:12.1.0-runtime-ubuntu22.04
# Use 'runtime' (~1 GB) unless you need to compile CUDA code,
# in which case use 'devel' (~4 GB).

%post
    apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev \
        cmake g++ make pkg-config \
        libboost-program-options-dev libboost-container-dev \
        nlohmann-json3-dev \
        tmux nano vim-tiny less curl wget git ca-certificates && \
    ln -sf /usr/bin/vim.tiny /usr/bin/vim && \
    rm -rf /var/lib/apt/lists/*

    # If using the CUDA base image (which lacks Python), uncomment:
    # apt-get update && apt-get install -y --no-install-recommends \
    #     python3 python3-pip python3-dev \
    #     libomp-dev libgl1-mesa-glx libglib2.0-0 \
    #     tmux nano vim-tiny less curl wget git && \
    # ln -sf /usr/bin/vim.tiny /usr/bin/vim && \
    # rm -rf /var/lib/apt/lists/*

    # *** DO NOT put pip install here. Use setup.sh instead. ***

    # Compute nodes are offline. Prefetch the crates needed to build the
    # Regular Games CLI at runtime, without depending on host-side %files.
    mkdir -p /tmp/rg_cargo_prefetch/src && \
    cat > /tmp/rg_cargo_prefetch/Cargo.toml <<'EOF'
[package]
name = "rg-cargo-prefetch"
version = "0.1.0"
edition = "2021"

[dependencies]
clap = { version = "4.5.21", features = ["derive"] }
rand = { version = "0.8.5", features = ["small_rng"] }
schemars = "1.2.1"
serde = { version = "1.0.152", features = ["derive", "rc"] }
serde_json = "1.0.91"
web-time = "1.1.0"
nom = "8.0.0"
nom-language = "0.1.0"
nom_locate = "5.0.0"
natord = "1.0.9"
quote = "1.0.23"
syn = "2.0.68"
EOF
    echo 'fn main() {}' > /tmp/rg_cargo_prefetch/src/main.rs && \
        cd /tmp/rg_cargo_prefetch && \
        CARGO_NET_OFFLINE=false cargo fetch --target x86_64-unknown-linux-gnu && \
        rm -rf /tmp/rg_cargo_prefetch

    mkdir -p /home/user/data
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
    export CARGO_HOME=/usr/local/cargo
    export CARGO_NET_OFFLINE=true
